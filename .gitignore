# Files git should not track: dependencies, caches, model downloads, secrets,
# and the recordings saved for tuning.

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.vscode/

# Node
node_modules/
dist/

# Environment and editor
.env
.env.local
.DS_Store

# Saved attempt recordings (kept locally for threshold tuning)
data/attempts/*
!data/attempts/.gitkeep

# Album covers used by the prototype are copyrighted (see docs/design/ui.md §11)
frontend/prototype/assets/covers/
# ... and the app loads them from here (see frontend/src/theme/songThemes.ts)
frontend/public/covers/

# Song tracks are copyrighted and the repository is public: share them outside git.
# Ignored wherever a song folder lands, not only under data/songs/.
data/songs/*/audio.*
audio.mp3
audio.m4a
audio.wav
audio.flac
audio.ogg
# Line cuts written by build_song --check: also copyrighted
data/songs/*/check/
/*/check/
# Song bundles from the team share belong in data/songs/<song_id>/, not at the repo root
/jasmine-flower/
/yi-jian-mei/
/yue-liang-dai-biao-wo-de-xin/
# Sung prompt clips for the recording session, cut from the tracks: also copyrighted
backend/tests/fixtures/prompts/lines/*__sung.wav
